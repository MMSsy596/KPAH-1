<service>
  <id>kpah-mysql</id>
  <name>KPAH MySQL</name>
  <description>KPAH standalone MySQL server</description>
  <executable>C:\mysql\bin\mysqld.exe</executable>
  <arguments>--defaults-file=C:\mysql\bin\my.ini --standalone</arguments>
  <workingdirectory>C:\mysql\bin</workingdirectory>
  <logpath>C:\Users\Administrator\Downloads\SEVER-KPAH-FULL\ops\win10-production\staging\services\logs</logpath>
  <log mode="roll-by-size"></log>
  <startmode>Automatic</startmode>
  <onfailure action="restart" delay="10 sec" />
</service>
