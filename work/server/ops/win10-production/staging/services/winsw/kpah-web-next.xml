<service>
  <id>kpah-web-next</id>
  <name>KPAH Web Next</name>
  <description>KPAH Next.js web server behind nginx</description>
  <executable>C:\Windows\System32\cmd.exe</executable>
  <arguments>/c "C:\Program Files\nodejs\npm.cmd" run start</arguments>
  <workingdirectory>C:\Users\Administrator\Downloads\SEVER-KPAH-FULL\web\web</workingdirectory>
  <logpath>C:\Users\Administrator\Downloads\SEVER-KPAH-FULL\ops\win10-production\staging\services\logs</logpath>
  <log mode="roll-by-size"></log>
  <startmode>Automatic</startmode>
  <depend>kpah-mysql</depend>
  <onfailure action="restart" delay="10 sec" />
</service>
