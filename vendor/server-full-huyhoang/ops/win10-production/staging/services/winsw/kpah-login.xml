<service>
  <id>kpah-login</id>
  <name>KPAH Login Server</name>
  <description>KPAH Java login socket</description>
  <executable>C:\Program Files\Java\jdk-23\bin\java.exe</executable>
  <arguments>-Xms256m -Xmx512m -Djava.net.preferIPv4Stack=true -Dfile.encoding=UTF-8 -jar C:\Users\Administrator\Downloads\SEVER-KPAH-FULL\loginServer\CheckLoginSocket.jar</arguments>
  <workingdirectory>C:\Users\Administrator\Downloads\SEVER-KPAH-FULL\loginServer</workingdirectory>
  <logpath>C:\Users\Administrator\Downloads\SEVER-KPAH-FULL\ops\win10-production\staging\services\logs</logpath>
  <log mode="roll-by-size"></log>
  <startmode>Automatic</startmode>
  <depend>kpah-mysql</depend>
  <onfailure action="restart" delay="10 sec" />
</service>
